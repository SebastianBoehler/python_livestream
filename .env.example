
# Continuous terminal stream (default Docker/Compose entry point)
STREAM_URL=https://www.hb-capital.app/livestream
# Prefer a root-readable mounted secret file in production. Direct env is a local fallback.
YOUTUBE_STREAM_KEY_FILE=
YOUTUBE_STREAM_KEY=your-stream-key-here
# Optional local smoke endpoint, for example rtmp://127.0.0.1:1935/live/test
STREAM_OUTPUT_URL=
# Receiver-free smoke output; mutually exclusive with STREAM_OUTPUT_URL
STREAM_OUTPUT_FILE=
FFMPEG_PATH=ffmpeg
VIRTUAL_DISPLAY=:99

# Narrated show pipeline (python stream_url.py)
GEMINI_API_KEY=your-gemini-api-key-here
XAI_API_KEY=your-xai-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here
ELEVENLABS_API_KEY=your-11labs-api-key-here
SHOW_ID=hb_capital
SHOW_CONFIG_PATH=
NEWS_INTERVAL_MINUTES=15
NEWS_SEGMENT_SECONDS=180
STREAM_CAPTURE_BACKEND=playwright
STREAM_ORIENTATION=landscape
STREAM_FPS=12
STREAM_WIDTH=1280
STREAM_HEIGHT=720
STREAM_VIDEO_ENCODER=
STREAM_X264_PRESET=veryfast
SEGMENT_BUFFER_SIZE=3
INTER_SEGMENT_MUSIC_SECONDS=0
INTER_SEGMENT_DELAY_SECONDS=0
TTS_PARALLELISM=3
TTS_MAX_CHARS_PER_CHUNK=450
NEWS_LLM_PROVIDER_ORDER=xai
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_MODELS=
OPENROUTER_PROVIDER_ORDER=
OPENROUTER_PLUGINS=
SCREEN_CAPTURE_DEVICE=3
SCREEN_CAPTURE_PIXEL_FORMAT=bgr0
SCREEN_CAPTURE_CURSOR=false
SCREEN_BROWSER_FULLSCREEN=true
VIRTUAL_DISPLAY_SCREEN=0
VIRTUAL_DISPLAY_COLOR_DEPTH=24
VIRTUAL_DISPLAY_CURSOR=false
